# Copy to .env. Leave the chain vars unset to run in MOCK mode (default, no
# external dependency, no funds needed). Configure them to switch to REAL
# mode: the backend itself signs and broadcasts every sub-wallet deployment
# and transaction execution against the given RPC/contract - see
# src/services/chainExecutor.ts.
PORT=4000

# --- Persistence (src/store/db.ts) ---
# "memory" wipes all data on restart; default "sqlite" persists to
# data/bitgo-agent-wallet.sqlite (gitignored).
PERSISTENCE_MODE=sqlite

# --- Chain (required for REAL mode) ---
CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
AGENT_SUB_WALLET_FACTORY_ADDRESS=0x97FCa4F8B07C7645552925860673943C086C6189

# --- Signing key: pick ONE of the three options below (see keyCustody.ts) ---

# Option A (preferred) - real threshold-ECDSA MPC via BitGo's own audited
# DKLS implementation (@bitgo/sdk-lib-mpc). Never assembles the full private
# key anywhere, at any point. Generate with `npm run generate-mpc-keys`.
# CHAIN_MPC_KEY_SHARE_A=<base64>
# CHAIN_MPC_KEY_SHARE_B=<base64>

# Option B - M-of-N Shamir's Secret Sharing custody. Reconstructs the full
# key transiently to sign. Generate with `npm run split-key -- <privateKeyHex> 3 2`.
# CHAIN_SIGNER_KEY_SHARES=0x...,0x...,0x...

# Option C - single hot key (simplest, single point of storage):
CHAIN_SIGNER_PRIVATE_KEY=

# Verifies whichever option above reconstructs/resolves to the expected
# address - recommended for B and C, and a sanity check for A.
CHAIN_SIGNER_EXPECTED_ADDRESS=

# --- Real economic value transfer (chainExecutor.ts / priceOracle.ts) ---
# The ETH/USD rate is REAL - fetched live from Chainlink Price Feeds
# (docs.chain.link/data-feeds/price-feeds/addresses), no API key needed.
# Default below is the Sepolia ETH/USD feed (matches CHAIN_RPC_URL's default).
CHAINLINK_ETH_USD_FEED_ADDRESS=0x694AA1769357215DE4FAC081bf1f309aDC325306
# Used only if the live Chainlink feed is unreachable or stale.
CHAIN_FALLBACK_ETH_USD_PRICE=2500
# Max feed age (seconds) before it's treated as stale rather than trusted.
CHAIN_PRICE_MAX_STALENESS_SECONDS=86400
# The rate above is real; this scales the *amount* actually moved on-chain
# down to a testnet-safe size - a deliberate demo-safety choice, not a fake
# price. 0.0005 => a $1,000 tx at ~$2,500/ETH moves 0.0002 ETH.
CHAIN_VALUE_SCALE_FACTOR=0.0005
# How much ETH to fund each newly deployed AgentSubWallet with.
CHAIN_SUB_WALLET_FUNDING_ETH=0.0003
# Never let a real send take the treasury below this floor.
CHAIN_MIN_TREASURY_RESERVE_ETH=0.005
