# Copy to .env. Leave all three chain vars unset to run in MOCK mode (default,
# no external dependency). Set all three to switch to REAL mode: the backend
# itself signs and broadcasts every sub-wallet deployment and transaction
# execution against the given RPC/contract - see src/services/chainExecutor.ts.
PORT=4000

CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_SIGNER_PRIVATE_KEY=
AGENT_SUB_WALLET_FACTORY_ADDRESS=0x97FCa4F8B07C7645552925860673943C086C6189
