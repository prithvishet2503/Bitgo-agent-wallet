{
  "name": "bitgo-agent-wallet",
  "private": true,
  "version": "0.1.0",
  "description": "BitGo Agent Wallet - institutional-grade agentic wallet product (v1)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace apps/frontend",
    "clean": "tsc -b --clean",
    "dev:backend": "npm run dev --workspace apps/backend",
    "dev:frontend": "npm run dev --workspace apps/frontend",
    "dev:cli": "npm run dev --workspace apps/cli --",
    "dev:mcp": "npm run dev --workspace apps/mcp-server",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^20.16.11"
  },
  "engines": {
    "node": ">=20"
  }
}
